FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 8e6;

boundaryField
{
    topHeated
    {
        type            calculated;
        value           $internalField;
    }
    solidInsulated
    {
        type            calculated;
        value           $internalField;
    }
    symmetrySolid
    {
        type            symmetryPlane;
    }
    solid_to_fluid
    {
        type            calculated;
        value           $internalField;
    }
}