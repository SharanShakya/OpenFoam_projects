// Bulk quantities on x-planes of the FLUID region (included by controlDict)
// T, h : mass-flux (phi) weighted;  p : area average

bulk_plane0
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    region          fluid;
    writeControl    timeStep;
    writeInterval   200;
    writeFields     false;
    log             false;
    regionType      faceZone;
    name            plane0;
    operation       weightedAverage;
    weightField     phi;
    fields          (T h);
}
pAvg_plane0
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    region          fluid;
    writeControl    timeStep;
    writeInterval   200;
