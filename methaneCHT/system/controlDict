FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionSimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         30000;              // steady state: iterations
deltaT          1;

writeControl    timeStep;
writeInterval   1000;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    // x-plane bulk quantities in the heated section (generated by makeCase.py)
    #include "bulkPlanes"

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        region          fluid;
        writeControl    writeTime;
    }

    // Heat flux through the fluid-solid interface (integral in W = check against q*A)
    wallHeatFlux
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        region          fluid;
        patches         (fluid_to_solid);
        writeControl    writeTime;
    }

    inletMassFlow
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        region          fluid;
        writeControl    timeStep;
        writeInterval   100;
        writeFields     false;
        log             false;
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          (phi);
    }

    outletMassFlow
    {
        $inletMassFlow;
        name            outlet;
    }

    inletAverage
    {
        $inletMassFlow;
        operation       areaAverage;
        fields          (p T);
    }

    outletAverage
    {
        $inletMassFlow;
        name            outlet;
        operation       weightedAverage;
        weightField     phi;
        fields          (T h);
    }

    minMaxFluid
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        region          fluid;
        writeControl    timeStep;
        writeInterval   100;
        log             false;
        fields          (T U);
    }

    minMaxSolid
    {
        $minMaxFluid;
        region          solid;
        fields          (T);
    }

    // Mean exterior temperature of the heated top wall (T_w,twe in Eq. 11)
    topHeatedT
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        region          solid;
        writeControl    timeStep;
        writeInterval   100;
        writeFields     false;
        log             false;
        regionType      patch;
        name            topHeated;
        operation       areaAverage;
        fields          (T);
    }
}
