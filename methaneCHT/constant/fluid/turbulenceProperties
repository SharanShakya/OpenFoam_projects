FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluid";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    model           kOmegaSST;      // near-wall resolved (y+ < 1) instead of the paper's k-eps + EWT
    turbulence      on;
    printCoeffs     on;
}
